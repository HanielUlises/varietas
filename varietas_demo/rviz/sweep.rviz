Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 600
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 12
      Color: 60; 60; 66
      Alpha: 0.35
      Line Style:
        Line Width: 0.03
        Value: Lines
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      # Transient Local, because robot_state_publisher latches the description:
      # it publishes it once, at start-up, and then never again. A volatile
      # subscriber is compatible with that publisher and so connects without
      # complaint, but it is only handed messages published after it
      # subscribed, and rviz subscribes when it has finished loading, which is
      # later. The display then sits in error with no model at all, or with a
      # model it cannot place, and the arm draws as a white shape that is not
      # the robot. It came up either way depending on which process won the
      # race, which is the worst way for it to be wrong. Asking for the
      # durability the publisher offers makes the description arrive every
      # time.
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/MarkerArray
      Name: VarietasTool
      Enabled: true
      Namespaces:
        varietas: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /varietas_markers
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Marker Scale: 0.2
  Global Options:
    Background Color: 24; 26; 31
    Fixed Frame: lbr_iiwa_link_0
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.15
      Focal Point:
        X: -0.04
        Y: 0.06
        Z: 0.62
      Pitch: 0.30
      Yaw: 0.85
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 720
  Width: 1180
  QMainWindow State: ""
